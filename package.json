{
  "name": "@specrun/cli",
  "version": "0.1.0-beta6",
  "description": "Lightweight CLI agentic workflow framework",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spichen/specrun.git"
  },
  "homepage": "https://github.com/spichen/specrun",
  "bugs": {
    "url": "https://github.com/spichen/specrun/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "workflow",
    "llm",
    "ai",
    "openai",
    "agentic"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "main": "dist/index.js",
  "bin": {
    "specrun": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:vendor": "pnpm --filter agentspec build",
    "prepare": "pnpm run build:vendor",
    "prepublishOnly": "pnpm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agentspec": "workspace:*",
    "commander": "^13.1.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.85.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.14",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
