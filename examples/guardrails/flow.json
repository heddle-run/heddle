{
  "weave": 1,
  "name": "guarded-assistant",
  "description": "An assistant carrying four Processor transforms, with a switch routing on a rejection.",
  "inputs": {
    "query": "string"
  },
  "steps": [
    {
      "name": "assistant",
      "agent": {
        "model": {
          "provider": "openai",
          "model": "gpt-4o-mini",
          "api_key": "$OPENAI_API_KEY"
        },
        "prompt": "You are a concise, helpful assistant. Answer the user's question directly.\n\nThe question: {{inputs.query}}",
        "transforms": [
          {
            "use": "Processor",
            "handler": "redact",
            "phase": "pre",
            "config": {
              "patterns": [
                "\\b\\d{3}-\\d{2}-\\d{4}\\b",
                "\\b[\\w.%+-]+@[\\w.-]+\\.[A-Za-z]{2,}\\b"
              ],
              "replacement": "[REDACTED]"
            }
          },
          {
            "use": "Processor",
            "handler": "blocklist",
            "phase": "pre",
            "config": {
              "patterns": [
                "ignore (all |your )?(previous |prior )?instructions",
                "reveal your (system )?prompt",
                "disregard the above"
              ],
              "reason": "the request looks like a prompt-injection attempt",
              "refusal": "I can't help with that request."
            }
          },
          {
            "use": "Processor",
            "handler": "redact",
            "phase": "post",
            "config": {
              "patterns": ["sk-[A-Za-z0-9]{16,}", "\\bAKIA[0-9A-Z]{16}\\b"],
              "replacement": "[REDACTED SECRET]"
            }
          },
          {
            "use": "Processor",
            "handler": "require_substance",
            "phase": "post",
            "config": { "min_words": 3 }
          }
        ]
      }
    },
    {
      "name": "route",
      "switch": "{{assistant.transform_status}}",
      "cases": {
        "rejected": "blocked"
      },
      "else": "ok"
    }
  ],
  "outcomes": {
    "ok": {
      "result": "{{assistant.result}}"
    },
    "blocked": {
      "result": "{{assistant.result}}",
      "transform_status": "{{assistant.transform_status}}",
      "transform_reason": "{{assistant.transform_reason}}",
      "transform_name": "{{assistant.transform_name}}",
      "transform_phase": "{{assistant.transform_phase}}"
    }
  }
}
