{
  "weave": 1,
  "name": "research-flow",
  "description": "The smallest complete flow: one agent, two stub tools, input to output.",
  "inputs": {
    "query": "string"
  },
  "tools": {
    "web_search": {
      "description": "Search the web for information",
      "inputs": { "query": "string" },
      "outputs": { "results": "string" }
    },
    "calculator": {
      "description": "Perform mathematical calculations",
      "inputs": { "expression": "string" },
      "outputs": { "result": "string" }
    }
  },
  "steps": [
    {
      "name": "researcher",
      "agent": {
        "model": { "provider": "openai", "model": "gpt-4o" },
        "prompt": "You are a research assistant. Use tools to find information about: {{inputs.query}}",
        "tools": ["web_search", "calculator"]
      }
    }
  ]
}
