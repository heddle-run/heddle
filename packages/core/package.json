{
  "name": "@heddle-run/core",
  "version": "0.2.0-beta.1",
  "description": "Execution engine for Oracle Open Agent Specification flows",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heddle-run/heddle.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/heddle-run/heddle",
  "bugs": {
    "url": "https://github.com/heddle-run/heddle/issues"
  },
  "keywords": [
    "agent",
    "workflow",
    "llm",
    "ai",
    "openai",
    "agentic",
    "agent-spec"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "import": "./dist/portable.js",
      "default": "./dist/portable.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-portable.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^4.85.0",
    "yaml": "^2.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "agentspec": "workspace:*",
    "esbuild": "^0.25.12",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
