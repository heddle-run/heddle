{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heddle-playground",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // The engine image. Built from the repository root, so the build context is
  // two levels up — the Dockerfile copies packages/core and vendor/agentspec
  // alongside packages/server.
  "containers": [
    {
      "class_name": "HeddleEngine",
      "image": "../../packages/server/Dockerfile.cloudflare",
      "image_build_context": "../..",
      // One instance per run, so this is the ceiling on concurrent runs for
      // the whole deployment. Raise it with the rate limits, not ahead of them.
      "max_instances": 20,
      "instance_type": "basic"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "ENGINE", "class_name": "HeddleEngine" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HeddleEngine", "RateLimiter"]
    }
  ],

  "vars": {
    // The playground page's origin. Exact match — no wildcards, no suffixes.
    "ALLOWED_ORIGINS": "https://heddle.run",

    // The broker's own hostname: the single host a container is allowed to
    // reach, and where its model traffic is pointed. Both must be updated
    // together, and must match the deployed worker's route.
    "PROXY_HOST": "heddle-playground.workers.dev",
    "PROXY_URL": "https://heddle-playground.workers.dev/llm/v1",

    "UPSTREAM_BASE": "https://api.openai.com/v1",

    "RUNS_PER_MINUTE": "6",
    "MODEL_CALLS_PER_RUN": "20"
  }

  // Secrets, set with `wrangler secret put`:
  //   RUN_TOKEN_SECRET  HMAC key for run tokens
  //   OPENAI_API_KEY    the real model credential; never reaches a container
  //   TURNSTILE_SECRET  optional; when set, requests must carry a solved token
}
